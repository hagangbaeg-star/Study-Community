<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>회원가입</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="container">

    <div class="card">

        <h1>📝 회원가입</h1>

        <form action="/register" method="POST">

            <input
                type="text"
                name="username"
                placeholder="아이디"
                required
            >

            <br><br>

            <input
                type="email"
                name="email"
                placeholder="이메일"
                required
            >

            <br><br>

            <input
                type="password"
                name="password"
                placeholder="비밀번호"
                required
            >

            <br><br>

            <button type="submit">
                회원가입
            </button>

        </form>

        <br>

        <a href="/">
            <button>메인으로</button>
        </a>

    </div>

</div>

</body>
</html>